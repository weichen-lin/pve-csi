# Copy to .env and replace the example values; check loads it automatically.
# Nonempty environment variables take precedence. Shell expansion is disabled.
PVE_ENDPOINT='https://pve.example.com:8006'
PVE_TOKEN_ID='pve-csi@pve!csi-dev'
PVE_TOKEN_SECRET='replace-with-token-secret'
PVE_NODE='pve'
PVE_OWNER_VMID='7777'
PVE_STORAGE='data-ssd'
PVE_VMIDS='100,101'
PVE_CHECK_TIMEOUT='60s'

# Skip TLS verification for check only.
PVE_CHECK_INSECURE='false'

# Leave empty for system trust, or set a PEM CA file path.
PVE_CA_FILE=''
# PVE_CA_FILE='/path/to/pve-root-ca.pem'
