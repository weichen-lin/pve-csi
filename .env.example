# 範例值：複製成 .env 後換成自己的 PVE 設定。
# pve-csi check 會自動載入目前目錄的 .env；執行方式見 CHECK.md。
# 已匯出的同名非空環境變數會優先於此檔案。
# 每行 KEY=value，支援引號與註解，不展開變數或執行 shell 指令。
PVE_ENDPOINT='https://pve.example.com:8006'
PVE_TOKEN_ID='pve-csi@pve!csi-dev'
PVE_TOKEN_SECRET='replace-with-token-secret'
PVE_NODE='pve'
PVE_OWNER_VMID='7777'
PVE_STORAGE='data-ssd'
PVE_VMIDS='100,101'
PVE_CHECK_TIMEOUT='60s'

# 僅 check：暫時略過伺服器憑證驗證時設為 true，預設 false。
PVE_CHECK_INSECURE='false'

# 留空使用系統信任的 CA；私有 CA 請填入本機 PEM 憑證路徑。
PVE_CA_FILE=''
# PVE_CA_FILE='/path/to/pve-root-ca.pem'
